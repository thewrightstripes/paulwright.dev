---
---
<section id="top" class="hero">
  <canvas id="field" aria-hidden="true"></canvas>
  <div class="hero-fade" aria-hidden="true"></div>

  <span class="readout readout-tl" aria-hidden="true">CAM 01 · FOV 60°</span>
  <span class="readout readout-tr" aria-hidden="true">X −000.0 · Y 000.0</span>
  <span class="readout readout-bl" aria-hidden="true">Z-PLANE 00 · POINT FIELD</span>
  <span class="readout readout-br" aria-hidden="true">GRID 28U · SEATTLE, WA</span>

  <div class="wrap hero-inner">
    <div class="badge" data-depth="1.5">Senior Engineering Manager · Meta</div>
    <h1 data-depth="3">Paul<br />Wright</h1>
    <p class="bio" data-depth="2">
      I build things that work. Spatial computing and identity at Meta —
      and, on the side, a language-learning app and a VR board game.
    </p>
    <div class="focus" aria-label="Focus areas" data-depth="4">
      <span><i>01</i>Spatial computing</span>
      <span><i>02</i>Passkeys &amp; identity</span>
      <span><i>03</i>User trust</span>
      <span><i>04</i>Language learning</span>
    </div>
  </div>
</section>

<style>
.hero {
  overflow: hidden;
  border-bottom: 1px solid var(--line);
  min-height: min(88vh, 760px);
  display: flex;
  align-items: center;
}

#field {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.hero-fade {
  position: absolute;
  inset: auto 0 0 0;
  height: 180px;
  z-index: 1;
  background: linear-gradient(to bottom, transparent, var(--bg));
  pointer-events: none;
}

.readout {
  position: absolute;
  z-index: 2;
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 1px;
  color: var(--faint);
  text-transform: uppercase;
}
.readout-tl { top: 16px; left: 24px; }
.readout-tr { top: 16px; right: 24px; }
.readout-bl { bottom: 16px; left: 24px; }
.readout-br { bottom: 16px; right: 24px; color: var(--accent-dim); }

.hero-inner {
  position: relative;
  z-index: 3;
  width: 100%;
  padding-top: 72px;
  padding-bottom: 96px;
}

.badge {
  display: inline-block;
  border: 1px solid var(--accent-dim);
  color: var(--accent);
  padding: 4px 12px;
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 2px;
  margin-bottom: 22px;
  background: rgba(5, 8, 13, 0.65);
}

h1 {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: clamp(76px, 13vw, 168px);
  line-height: 0.92;
  letter-spacing: -0.01em;
  text-transform: uppercase;
  color: var(--fg);
  margin-bottom: 26px;
  text-wrap: balance;
}

.bio {
  font-family: var(--font-mono);
  font-size: 14px;
  color: var(--muted);
  border-left: 2px solid var(--accent);
  padding-left: 16px;
  max-width: 540px;
  line-height: 1.75;
  margin-bottom: 30px;
  background: rgba(5, 8, 13, 0.45);
}

.focus {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.focus span {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border: 1px solid var(--line);
  background: rgba(10, 16, 23, 0.8);
  padding: 5px 12px 5px 8px;
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--fg);
}

.focus span i {
  font-style: normal;
  color: var(--cool);
  font-size: 10px;
}

@media (max-width: 640px) {
  .readout-tr, .readout-bl { display: none; }
  .hero-inner { padding-top: 56px; padding-bottom: 72px; }
}
</style>

<script>
  // Perspective point-field: a wireframe grid plane in the hero that
  // tilts gently toward the pointer. Vanilla canvas, no dependencies.
  (() => {
    const canvas = document.getElementById('field');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const hero = canvas.parentElement;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const COLS = 17;          // lines running away from viewer (x: -8..8)
    const ROWS = 15;          // lines across
    const SPACING = 1;        // world units between grid lines
    const Z_NEAR = 2.2;       // nearest row distance
    const CAM_H = 2.6;        // camera height above the plane
    const FOCAL = 3.2;        // perspective focal length

    let w = 0, h = 0, raf = 0, running = false, visible = true;
    let tiltX = 0, tiltY = 0, tTiltX = 0, tTiltY = 0, scrollZ = 0;

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 1.75);
      const r = hero.getBoundingClientRect();
      w = r.width; h = r.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      if (reduced) draw(0);
    }

    function project(x, y, z) {
      // rotate around Y (tiltX) then X (tiltY)
      const cy = Math.cos(tiltX), sy = Math.sin(tiltX);
      const cx = Math.cos(tiltY), sx = Math.sin(tiltY);
      let rx = x * cy - z * sy;
      let rz = x * sy + z * cy;
      let ry = y * cx - rz * sx;
      rz = y * sx + rz * cx;
      const s = FOCAL / Math.max(rz, 0.6);
      const k = h * 0.075;
      const horizon = h * 0.5;
      return [w / 2 + rx * s * k, horizon - ry * s * k, s];
    }

    function draw(time) {
      ctx.clearRect(0, 0, w, h);
      const off = reduced ? 0 : (time * 0.00022) % SPACING;
      const pts = [];
      for (let i = 0; i < COLS; i++) {
        pts.push([]);
        for (let j = 0; j <= ROWS; j++) {
          const x = (i - (COLS - 1) / 2) * SPACING;
          const z = Z_NEAR + j * SPACING + off;
          pts[i].push(project(x, -CAM_H, z));
        }
      }
      // lines across (constant z) — fade with distance
      for (let j = 0; j <= ROWS; j++) {
        const z = Z_NEAR + j * SPACING + off;
        const fade = Math.max(0, 1 - (z - Z_NEAR) / (ROWS * SPACING + 2));
        ctx.strokeStyle = `rgba(110, 231, 255, ${0.05 + fade * 0.22})`;
        ctx.lineWidth = 1;
        ctx.beginPath();
        for (let i = 0; i < COLS; i++) {
          const [px, py] = pts[i][j];
          i === 0 ? ctx.moveTo(px, py) : ctx.lineTo(px, py);
        }
        ctx.stroke();
      }
      // lines away (constant x)
      for (let i = 0; i < COLS; i++) {
        ctx.strokeStyle = 'rgba(110, 231, 255, 0.10)';
        ctx.beginPath();
        for (let j = 0; j <= ROWS; j++) {
          const [px, py] = pts[i][j];
          j === 0 ? ctx.moveTo(px, py) : ctx.lineTo(px, py);
        }
        ctx.stroke();
      }
      // points — gold on a sparse cadence, cyan elsewhere
      for (let i = 0; i < COLS; i++) {
        for (let j = 0; j <= ROWS; j++) {
          const [px, py, s] = pts[i][j];
          if (py < -10 || py > h + 10 || px < -10 || px > w + 10) continue;
          const gold = (i + j) % 7 === 0;
          const r = Math.min(2.4, Math.max(0.6, s * 1.1));
          ctx.fillStyle = gold ? 'rgba(255, 208, 40, 0.85)' : 'rgba(110, 231, 255, 0.5)';
          ctx.beginPath();
          ctx.arc(px, py, r, 0, Math.PI * 2);
          ctx.fill();
        }
      }
    }

    function loop(time) {
      if (!running) return;
      tiltX += (tTiltX - tiltX) * 0.045;
      tiltY += (tTiltY - tiltY) * 0.045;
      draw(time);
      raf = requestAnimationFrame(loop);
    }

    function start() {
      if (running || reduced) return;
      running = true;
      raf = requestAnimationFrame(loop);
    }
    function stop() {
      running = false;
      cancelAnimationFrame(raf);
    }

    window.addEventListener('resize', resize);
    resize();

    if (!reduced) {
      window.addEventListener('pointermove', (e) => {
        const nx = e.clientX / window.innerWidth - 0.5;
        const ny = e.clientY / window.innerHeight - 0.5;
        tTiltX = nx * 0.22;
        tTiltY = -ny * 0.10;
      }, { passive: true });

      new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        visible ? start() : stop();
      }).observe(hero);

      document.addEventListener('visibilitychange', () => {
        document.hidden ? stop() : (visible && start());
      });

      start();
    }
  })();
</script>
