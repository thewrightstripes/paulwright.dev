---
---
<section id="top" class="hero">
  <div class="badge">Senior Engineering Manager · Meta</div>
  <h1>PAUL<br/>WRIGHT</h1>
  <p class="bio">
    I build things that work. Spatial computing and identity at Meta —
    and, on the side, a language-learning app and a VR board game.
  </p>
  <div class="focus" aria-label="Focus areas">
    <span>Spatial computing</span>
    <span>Passkeys &amp; identity</span>
    <span>User trust</span>
    <span>Language learning</span>
  </div>
</section>

<style>
.hero {
  padding: 48px 24px 56px;
  background: var(--bg);
}

.badge {
  display: inline-block;
  background: var(--accent);
  border: var(--border-thin);
  padding: 2px 10px;
  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 12px;
}

h1 {
  font-family: var(--font-display);
  font-size: clamp(72px, 14vw, 140px);
  line-height: 0.9;
  text-transform: uppercase;
  color: var(--fg);
  margin-bottom: 24px;
}

.bio {
  font-family: var(--font-mono);
  font-size: 13px;
  color: var(--muted);
  border-left: var(--border);
  padding-left: 14px;
  max-width: 520px;
  line-height: 1.7;
  margin-bottom: 24px;
}

.focus {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.focus span {
  border: var(--border-thin);
  padding: 2px 10px;
  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
}
</style>
